#!/bin/bash
# sertantai-enforcement Development Server Restarter
# Forcefully stops and restarts backend (Phoenix) and frontend (SvelteKit) servers
#
# Usage:
#   sert-enf-restart           # Restart all servers
#   sert-enf-restart --frontend # Restart only frontend (port 5173)
#   sert-enf-restart --docker  # Restart servers + Docker containers
#   sert-enf-restart --force   # Force kill immediately (skip graceful shutdown)
#
# Symlink Setup (to run from anywhere):
#   sudo ln -s /home/jason/Desktop/sertantai-enforcement/scripts/development/sert-enf-restart /usr/local/bin/sert-enf-restart

set -e

# Parse arguments
MANAGE_DOCKER=false
FORCE_KILL=false
FRONTEND_ONLY=false
for arg in "$@"; do
    case $arg in
        --docker)
            MANAGE_DOCKER=true
            ;;
        --force)
            FORCE_KILL=true
            ;;
        --frontend)
            FRONTEND_ONLY=true
            ;;
    esac
done

# Resolve symlink to get the actual script path
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"

if [ "$FRONTEND_ONLY" = true ]; then
    echo "🔄 Restarting frontend only..."
else
    echo "🔄 Restarting sertantai-enforcement development servers..."
fi
echo ""

# Function to kill processes with timeout and retry
kill_process_safely() {
    local process_pattern="$1"
    local process_name="$2"
    local max_wait=5

    if pgrep -f "$process_pattern" > /dev/null; then
        echo "🔥 Stopping $process_name..."

        if [ "$FORCE_KILL" = true ]; then
            # Force kill immediately
            pkill -9 -f "$process_pattern" || true
            echo "   ✅ $process_name force-killed"
        else
            # Try graceful shutdown first (SIGTERM)
            pkill -f "$process_pattern" || true

            # Wait up to max_wait seconds for graceful shutdown
            local waited=0
            while pgrep -f "$process_pattern" > /dev/null && [ $waited -lt $max_wait ]; do
                sleep 1
                waited=$((waited + 1))
                echo -n "."
            done
            echo ""

            # If still running, force kill (SIGKILL)
            if pgrep -f "$process_pattern" > /dev/null; then
                echo "   ⚠️  Graceful shutdown timed out, force killing..."
                pkill -9 -f "$process_pattern" || true
                sleep 1
            fi

            echo "   ✅ $process_name stopped"
        fi
    else
        echo "ℹ️  $process_name not running"
    fi
}

# Function to check if port is free
wait_for_port_free() {
    local port="$1"
    local max_wait=10
    local waited=0

    while lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1 && [ $waited -lt $max_wait ]; do
        if [ $waited -eq 0 ]; then
            echo "⏳ Waiting for port $port to be freed..."
        fi
        sleep 1
        waited=$((waited + 1))
        echo -n "."
    done

    if [ $waited -gt 0 ]; then
        echo ""
    fi

    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then
        echo "   ⚠️  Port $port still in use after ${max_wait}s"
        echo "   Process using port:"
        lsof -Pi :$port -sTCP:LISTEN || true
        echo "   Killing process on port $port..."
        lsof -ti:$port | xargs kill -9 2>/dev/null || true
        sleep 1
    fi
}

# Stop existing processes
if [ "$FRONTEND_ONLY" = true ]; then
    echo "📋 Step 1/2: Stopping frontend process"
else
    echo "📋 Step 1/3: Stopping existing processes"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ "$FRONTEND_ONLY" = false ]; then
    # Kill sertantai-auth service
    kill_process_safely "mix phx.server.*sertantai_auth" "sertantai-auth service"

    # Kill Phoenix backend
    kill_process_safely "mix phx.server.*ehs_enforcement" "Phoenix backend"

    # Kill Elixir BEAM processes (in case mix process doesn't catch them all)
    if pgrep -f "beam.smp.*sertantai\|beam.smp.*ehs_enforcement" > /dev/null; then
        echo "🔥 Stopping BEAM VM processes..."
        pkill -9 -f "beam.smp.*sertantai\|beam.smp.*ehs_enforcement" || true
        echo "   ✅ BEAM processes stopped"
    fi
fi

# Kill SvelteKit frontend
kill_process_safely "vite dev.*5173" "SvelteKit frontend"

# Kill any node processes on port 5173
if lsof -ti:5173 >/dev/null 2>&1; then
    echo "🔥 Killing remaining processes on port 5173..."
    lsof -ti:5173 | xargs kill -9 2>/dev/null || true
fi

echo ""

# Wait for ports to be freed
if [ "$FRONTEND_ONLY" = true ]; then
    echo "📋 Step 2/2: Ensuring port is available"
else
    echo "📋 Step 2/3: Ensuring ports are available"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ "$FRONTEND_ONLY" = false ]; then
    wait_for_port_free 4000  # sertantai-auth
    wait_for_port_free 4002  # Phoenix backend
fi
wait_for_port_free 5173  # SvelteKit frontend

if [ "$FRONTEND_ONLY" = true ]; then
    echo "   ✅ Port 5173 is free"
else
    echo "   ✅ Ports 4000, 4002, and 5173 are free"
fi
echo ""

# Handle Docker if requested
if [ "$MANAGE_DOCKER" = true ]; then
    echo "🐳 Managing Docker containers..."
    cd "$PROJECT_ROOT"

    # Stop existing containers
    docker compose -f docker-compose.dev.yml down

    # Start fresh containers
    echo "   Starting Docker services (postgres, electric, redis)..."
    docker compose -f docker-compose.dev.yml up -d postgres electric redis

    echo "   Waiting for services to be healthy..."
    sleep 5

    # Verify Docker services are up
    if docker ps | grep -q "sertantai_enforcement_postgres"; then
        echo "   ✅ Docker services running"
    else
        echo "   ⚠️  Warning: Docker services may not be fully ready"
    fi
    echo ""
fi

# Start servers
if [ "$FRONTEND_ONLY" = true ]; then
    echo "📋 Step 2/2: Starting frontend"
else
    echo "📋 Step 3/3: Starting development servers"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Verify PROJECT_ROOT and mix.exs exist
if [ ! -d "$PROJECT_ROOT" ] || [ ! -f "$PROJECT_ROOT/mix.exs" ]; then
    echo "❌ Error: Project root or mix.exs not found"
    exit 1
fi

# Check Docker if not managing it
if [ "$MANAGE_DOCKER" = false ] && [ "$FRONTEND_ONLY" = false ]; then
    if ! docker ps | grep -q "sertantai_enforcement_postgres"; then
        echo "⚠️  Docker containers not detected"
        echo "   Tip: Use 'sert-enf-restart --docker' to restart with Docker"
        echo ""
    fi
fi

if [ "$FRONTEND_ONLY" = true ]; then
    echo "📦 Opening frontend tab..."
else
    echo "📦 Opening terminal tabs..."
fi

# Create a temporary launcher script
AUTH_DIR="/home/jason/Desktop/sertantai_auth"
LAUNCHER_SCRIPT=$(mktemp)

if [ "$FRONTEND_ONLY" = true ]; then
    # Frontend only - just open one tab
    cat > "$LAUNCHER_SCRIPT" << 'LAUNCHER_EOF'
#!/bin/bash

PROJECT_ROOT="__PROJECT_ROOT__"

# Open SvelteKit frontend tab
gnome-terminal --tab --title="sertantai-enforcement-frontend" --working-directory="$PROJECT_ROOT/frontend" -- bash -c 'echo "⚡ Starting SvelteKit frontend on port 5173..."; echo "📁 Working directory: $(pwd)"; echo ""; npm run dev; echo ""; echo "Service stopped. Press Enter to close tab..."; read' &

# Wait for all background processes
wait
LAUNCHER_EOF
else
    # All services - open all tabs
    cat > "$LAUNCHER_SCRIPT" << 'LAUNCHER_EOF'
#!/bin/bash

AUTH_DIR="/home/jason/Desktop/sertantai_auth"
PROJECT_ROOT="__PROJECT_ROOT__"

# Open sertantai-auth tab if directory exists
if [ -d "$AUTH_DIR" ]; then
    gnome-terminal --tab --title="sertantai-auth-service" --working-directory="$AUTH_DIR" -- bash -c 'echo "🔐 Starting sertantai-auth service on port 4000..."; echo "📁 Working directory: $(pwd)"; echo ""; mix phx.server; echo ""; echo "Service stopped. Press Enter to close tab..."; read' &
    sleep 0.3
fi

# Open Phoenix backend tab
gnome-terminal --tab --title="sertantai-enforcement-backend" --working-directory="$PROJECT_ROOT" -- bash -c 'echo "🔥 Starting Phoenix backend on port 4002..."; echo "📁 Working directory: $(pwd)"; echo ""; mix phx.server; echo ""; echo "Service stopped. Press Enter to close tab..."; read' &
sleep 0.3

# Open SvelteKit frontend tab
gnome-terminal --tab --title="sertantai-enforcement-frontend" --working-directory="$PROJECT_ROOT/frontend" -- bash -c 'echo "⚡ Starting SvelteKit frontend on port 5173..."; echo "📁 Working directory: $(pwd)"; echo ""; npm run dev; echo ""; echo "Service stopped. Press Enter to close tab..."; read' &

# Wait for all background processes
wait
LAUNCHER_EOF
fi

# Replace PROJECT_ROOT placeholder
sed -i "s|__PROJECT_ROOT__|$PROJECT_ROOT|g" "$LAUNCHER_SCRIPT"
chmod +x "$LAUNCHER_SCRIPT"

# Check if auth directory exists and warn (only if not frontend-only mode)
if [ "$FRONTEND_ONLY" = false ] && [ ! -d "$AUTH_DIR" ]; then
    echo "⚠️  Warning: sertantai-auth not found at $AUTH_DIR"
    echo "   JWT authentication will not work without it!"
fi

# Execute the launcher script in a new gnome-terminal window
gnome-terminal --window -- bash -c "$LAUNCHER_SCRIPT; rm -f $LAUNCHER_SCRIPT"

echo ""
if [ "$FRONTEND_ONLY" = true ]; then
    echo "✅ Frontend restarted successfully!"
    echo ""
    echo "📊 URL:"
    echo "   Frontend: http://localhost:5173  (svelte)"
else
    echo "✅ Development servers restarted successfully!"
    echo ""
    echo "📊 URLs:"
    echo "   Auth:     http://localhost:4000  (sertantai-auth)"
    echo "   Backend:  http://localhost:4002  (ehs-enforcement)"
    echo "   Frontend: http://localhost:5173  (svelte)"
    echo "   Electric: http://localhost:3001  (sync)"
fi
echo ""
echo "💡 Tips:"
echo "   Stop servers:      sert-enf-stop"
echo "   Restart all:       sert-enf-restart"
echo "   Restart frontend:  sert-enf-restart --frontend"
echo "   Force restart:     sert-enf-restart --force"
if [ "$MANAGE_DOCKER" = true ]; then
    echo "   (Docker was restarted)"
elif [ "$FRONTEND_ONLY" = false ]; then
    echo "   (Docker was not restarted - use --docker flag to restart Docker)"
fi
echo ""
